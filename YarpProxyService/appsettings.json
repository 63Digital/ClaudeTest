{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Proxy": {
    "Uri": "http://proxy-server.example.com:8080",
    "Username": "",
    "Password": "",
    "Type": "Http",
    "TimeoutSeconds": 30
  },
  "ReverseProxy": {
    "Routes": {
      "default-route": {
        "ClusterId": "default-cluster",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "default-cluster": {
        "Destinations": {
          "primary": {
            "Address": "https://www.example.com"
          }
        }
      }
    }
  },
  "UrlRewriting": {
    "Enabled": true,
    "RewriteContentTypes": [
      "text/html",
      "text/css",
      "application/javascript",
      "text/javascript",
      "application/json"
    ]
  },
  "Scaling": {
    "FastPath": {
      "Enabled": true,
      "MaxConcurrentRequests": 1000
    },
    "BrowserPath": {
      "Enabled": false,
      "Comment": "Set to true to enable headless browser rendering for JavaScript-heavy sites"
    }
  },
  "BrowserPool": {
    "MinSize": 2,
    "MaxSize": 10,
    "Comment": "Browser pool settings - only used when BrowserPath is enabled"
  }
}
