{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Yarp": "Debug",
      "YarpProxyService": "Debug"
    }
  },
  "Proxy": {
    "Uri": "http://localhost:8888",
    "Username": "",
    "Password": "",
    "Type": "Http",
    "TimeoutSeconds": 60
  },
  "ReverseProxy": {
    "Routes": {
      "default-route": {
        "ClusterId": "default-cluster",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "default-cluster": {
        "Destinations": {
          "primary": {
            "Address": "https://httpbin.org"
          }
        }
      }
    }
  },
  "UrlRewriting": {
    "Enabled": true,
    "RewriteContentTypes": [
      "text/html",
      "text/css",
      "application/javascript",
      "text/javascript",
      "application/json"
    ]
  }
}
